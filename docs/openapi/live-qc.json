  "info": {
    "title": "Live QC API",
    "description": "Live QC service for the livestream-admin Live QC pages. Contract: docs/contract/live-qc-api.md.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ]
      },
      "ShopRowDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "platform": {
            "type": "string",
            "enum": [
              "tiktok",
              "shopee"
            ]
          },
          "label": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "local",
              "backend"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "live",
              "offline",
              "unknown",
              "no_signal",
              "checking",
              "not_checked"
            ]
          },
          "job_state": {
            "type": "string",
            "enum": [
              "stopped",
              "retrying",
              "checking_image",
              "playing",
              "stopping",
              "error"
            ]
          },
          "attempts": {
            "type": "number"
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "checked_at": {
            "type": "string",
            "nullable": true
          },
          "live_since": {
            "type": "string",
            "nullable": true
          },
          "frame_url": {
            "type": "string",
            "nullable": true,
            "description": "Path from the host root with a `t` query that changes on every new frame; null until the first frame."
          },
          "cookie_set": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "platform",
          "label",
          "source",
          "status",
          "job_state",
          "attempts",
          "message",
          "checked_at",
          "live_since",
          "frame_url",
          "cookie_set"
        ]
      },
      "ShopListResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShopRowDto"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "ShopConfigDto": {
        "type": "object",
        "properties": {
          "platform": {
            "enum": [
              "tiktok",
              "shopee"
            ],
            "type": "string"
          },
          "username": {
            "type": "string",
            "description": "Required for TikTok shops."
          },
          "name": {
            "type": "string"
          },
          "user_id": {
            "type": "number",
            "minimum": 1
          },
          "shop_id": {
            "type": "number",
            "minimum": 1
          },
          "live_url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "platform"
        ]
      },
      "SessionInfoDto": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "shopee_status": {
            "type": "number",
            "nullable": true
          },
          "is_live": {
            "type": "boolean"
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "share_url": {
            "type": "string",
            "nullable": true
          },
          "expires_at": {
            "type": "string",
            "nullable": true
          },
          "source": {
            "type": "string"
          },
