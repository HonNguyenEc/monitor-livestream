# Copy to .env and adjust. Variables set in the shell override this file.

# Port of the local dashboard (http://localhost:<QC_PORT>).
QC_PORT=8765

# auto_lives backend the /login page signs in to (a trailing /api/v1 is accepted).
AUTO_LIVES_BACKEND_URL=http://localhost:8000

# Pages allowed to call the TypeScript service (comma-separated, scheme included): the livestream-admin dev server.
# Not the service's own address; Swagger UI at /docs is always allowed.
ALLOWED_ORIGINS=http://localhost:3004
